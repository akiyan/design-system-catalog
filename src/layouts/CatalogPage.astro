---
import { App } from '../App.jsx';
import { systems } from '../catalog';
import '../styles.css';
const { system } = Astro.props;
const selected = system || systems[0];
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || 'https://github.com/akiyan/design-system-catalog';
const title = system ? `${system.shortName} | デザインシステムカタログ` : 'デザインシステムカタログ';
---
<!doctype html>
<html lang="ja">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`国内外${systems.length}件の公開デザインシステムの実装コンポーネントを共通の内容で比較できるカタログ。注目の5件と公開日順の一覧を掲載。日本語と英語に対応。`} />
  <meta name="theme-color" content="#003cff" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="A visual catalog of public design systems. 日英対応のデザインシステムカタログ。" />
  <meta property="og:type" content="website" />
  {selected.specimen.status === 'ready' && <meta property="og:image" content={new URL(`/specimens/thumbnails/${selected.id}-${selected.views[0].key}.webp`, Astro.site)} />}
  <title>{title}</title>
 </head>
 <body>
  <App client:load githubUrl={githubUrl} initialId={system?.id || null} />
  <noscript><p style="padding:16px">プレビューの切り替えにはJavaScriptを有効にしてください。Enable JavaScript to switch previews.</p></noscript>
 </body>
</html>
