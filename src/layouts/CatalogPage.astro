---
import { App } from '../App.jsx';
import { systems } from '../catalog';
import '../styles.css';
const { system } = Astro.props;
const selected = system || systems[0];
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || 'https://github.com/akiyan/design-system-catalog';
const siteTitle='デザインシステムカタログ';
const title=system?`${system.shortName} | ${siteTitle}`:siteTitle;
---
<!doctype html>
<html lang="ja">
 <head>
  <script is:inline>
   window.dataLayer = window.dataLayer || [];
   function gtag(){dataLayer.push(arguments);}
   gtag('js', new Date());
   window.dataLayer.push({'gtm.start': Date.now(), event: 'gtm.js'});
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-N9ZZSCNJ"></script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={`国内外${systems.length}件の公開デザインシステムの実装コンポーネントを共通の内容で比較できるカタログ。注目の4件と公開日順の一覧を掲載。日本語と英語に対応。`} />
  <link rel="describedby" type="text/plain" href="/llms.txt" />
  <link rel="icon" href="/favicon.ico?v=layout-2" sizes="16x16 32x32" />
  <link rel="icon" type="image/png" href="/favicon-32.png?v=layout-2" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=layout-2" sizes="180x180" />
  <meta name="theme-color" content="#003cff" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="A visual catalog of public design systems. 日英対応のデザインシステムカタログ。" />
  <meta property="og:type" content="website" />
  {selected.specimen.status === 'ready' && <meta property="og:image" content={new URL(`/specimens/thumbnails/${selected.id}-${selected.views[0].key}.webp`, Astro.site)} />}
  <title>{title}</title>
 </head>
 <body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N9ZZSCNJ" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
  <App client:load githubUrl={githubUrl} initialId={system?.id || null} />
  <noscript><p style="padding:16px">プレビューの切り替えにはJavaScriptを有効にしてください。Enable JavaScript to switch previews.</p></noscript>
 </body>
</html>
